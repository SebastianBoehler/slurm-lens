[Unit]
Description=Slurm Lens cluster dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=slurm-lens
StateDirectoryMode=0700
WorkingDirectory=/var/lib/slurm-lens
EnvironmentFile=/etc/slurm-lens/credentials.env
ExecStart=/usr/local/bin/slurm-lens --live /etc/slurm-lens/connection.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
